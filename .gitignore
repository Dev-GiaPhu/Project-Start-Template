# Generic product repository ignore rules (language/framework neutral).
# Add framework-specific rules only after the new project is initialized.

# Operating systems
.DS_Store
Thumbs.db
Desktop.ini
*~

# Editor-specific local state
.vscode/
.idea/
*.swp
*.swo

# Temporary files and logs
*.log
*.tmp
*.temp
*.bak
.cache/
tmp/
temp/

# Local credentials: never push secrets to a repository
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
credentials.json
secrets.local.*

# Local test/coverage artifacts
.coverage
htmlcov/
coverage/
.pytest_cache/
__pycache__/

# Add project-specific build/cache paths after selecting a technology stack.

# AI memory recorder's ephemeral lock files; never commit them.
AI-Memory/conversations/**/.writer.lock

# Exports may contain multiple private chats and credentials; never stage them accidentally.
AI-Memory/imports/**
!AI-Memory/imports/.gitkeep

# Temporary atomic-write or local program caches.
AI-Memory/**/.tmp-*
AI-Memory/**/*.tmp-*
