{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAM Archive Event v2",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "sequence",
    "kind",
    "actor",
    "time",
    "links",
    "capture_status",
    "payload",
    "previous_hash",
    "hash"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "actor": {
      "type": "string"
    },
    "time": {
      "type": "object",
      "required": [
        "recorded_at",
        "recorded_at_utc",
        "occurred_at"
      ],
      "properties": {
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_event_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "capture_status": {
      "enum": [
        "captured",
        "partial",
        "missing"
      ]
    },
    "payload": {},
    "previous_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
