{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAM Archive Session v2",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "session_id",
    "platform",
    "created_at",
    "capture_method",
    "capture_status",
    "capture_gaps",
    "event_count",
    "last_event_hash",
    "attachments"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "source_conversation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "capture_method": {
      "type": "string"
    },
    "capture_status": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "capture_gaps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sha256",
          "size",
          "filename",
          "media_type"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "object_path": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "chunks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sha256",
                "size",
                "object_path"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "object_path": {
                  "type": "string"
                }
              }
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "object_path"
            ]
          },
          {
            "required": [
              "chunks"
            ]
          }
        ]
      }
    },
    "segment_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
